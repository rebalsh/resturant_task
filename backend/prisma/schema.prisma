datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// جدول الحجوزات (القلب النابض للمشروع)
model Reservation {
  id        String   @id @default(uuid()) 
  name      String
  email     String   
  date      String   
  time      String   
  guests    Int
  status    String   @default("pending") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// جدول قائمة الطعام (الميزة الإضافية)
model Menu {
  id          String   @id @default(uuid())
  dishName    String   // اسم الطبق
  price       Float    // سعر الطبق
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}